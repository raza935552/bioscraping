# ── BiolinX Affiliate Engine — environment ────────────────────────────────
# Copy to `.env` on the server (chmod 600). Only the vars in SECTION A must
# live here. Everything in SECTION B can be entered through the admin Settings
# page instead (stored AES-encrypted in the database), so you don't have to
# keep API keys in a file if you'd rather manage them in the UI.

# ═══ SECTION A — required in this file (never UI-managed) ══════════════════

NODE_ENV=production
TZ=UTC
# Canonical business timezone for "yesterday" / follow-up math.
BUSINESS_TZ=America/Los_Angeles

# MySQL (system of record).
DATABASE_URL=mysql://biolinx:CHANGE_ME@127.0.0.1:3306/biolinx_engine

# Signs session cookies. 32+ random chars. Rotating it logs everyone out.
#   generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Master key that encrypts the secrets stored via the Settings page (32-byte
# hex). Set a dedicated one in production so rotating APP_SECRET doesn't make
# stored settings undecryptable.
#   generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETTINGS_KEY=

# API port and the admin origin allowed by CORS (your subdomain in prod).
PORT=3001
ADMIN_ORIGIN=https://engine.biolinxlabs.com

# ═══ SECTION B — optional here; can be set in the admin Settings page ══════
# A value in the DB (via the UI) overrides the value here. Leave blank to
# manage entirely from the UI.

# Affiliate platform (iDevAffiliate)
IDEVAFFILIATE_URL=https://biolinxlabs.idevaffiliate.com
IDEVAFFILIATE_SITE_KEY=
IDEVAFFILIATE_API_SECRET=
RECRUITER_IDEV_ID=

# Cold email (Instantly)
COLD_EMAIL_API_KEY=
COLD_EMAIL_CAMPAIGN_ID=
INSTANTLY_WEBHOOK_SECRET=
SENDER_NAME=
SENDER_POSTAL_ADDRESS=
CHANNEL_AUTOSEND_EMAIL=false

# AI drafting (Anthropic)
ANTHROPIC_API_KEY=
DRAFT_MODEL=claude-sonnet-5
CLASSIFY_MODEL=claude-haiku-4-5-20251001

# Lead sourcing (Apify)
APIFY_TOKEN=

# Airtable (one-time migration only)
AIRTABLE_TOKEN=

# Alerts & digest (Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Store webhook (biolinxlabs.com → engine)
STORE_WEBHOOK_SECRET=
